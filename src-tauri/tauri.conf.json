{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Thermite",
  "version": "0.1.0",
  "identifier": "local.thermite",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Thermite",
        "width": 1320,
        "height": 900,
        "minWidth": 560,
        "minHeight": 420,
        "backgroundColor": "#1b1e20"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Temperature charts for every hardware sensor",
    "linux": {
      "deb": {
        "conflicts": ["thermal-monitor"],
        "replaces": ["thermal-monitor"]
      },
      "rpm": {
        "obsoletes": ["thermal-monitor"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
